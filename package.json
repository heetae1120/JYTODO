{
  "name": "jytodo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.js --production",
    "test": "node --test test/*.test.js",
    "test:ui": "node test/ui.smoke.js",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux --dir",
    "test:desktop": "node test/desktop.smoke.js",
    "setup:electron": "node --use-env-proxy node_modules/electron/install.js",
    "package:installer:win": "npm run build && electron-builder --win nsis --x64",
    "test:rls": "node test/rls.integration.js",
    "test:accounts:ui": "node test/accounts.ui.js",
    "test:cloud": "node --use-env-proxy test/cloud.live.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.56.0",
    "vite": "^6.4.1"
  },
  "main": "desktop/main.js",
  "description": "시간순 할 일과 예약 팝업을 제공하는 Windows 데스크톱 프로그램",
  "author": "JYTODO"
}
