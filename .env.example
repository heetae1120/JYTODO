# Single-user, local application. Do not expose to the public Internet without authentication.
PORT=3000
APP_URL=http://localhost:3000
# Google Cloud OAuth web client. Enable Calendar API and register this exact redirect URI:
# http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack app Incoming Webhook. Never put this URL in browser code.
SLACK_WEBHOOK_URL=
